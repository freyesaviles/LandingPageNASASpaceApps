---
import "../styles/global.css";

const socials = {
  instagram: "https://www.instagram.com/nasa.spacechallengeuam?stkn=MXU1c3Vobm9xOHVjNg%3D%3D",
  tiktok: "https://www.tiktok.com/@nasa.spacechallengeuam",
  organizers: "https://linktr.ee/artemisdevs2026",
};
const officialUrl = "https://www.spaceappschallenge.org/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="NASA Space Apps Challenge Managua. 48 horas para crear soluciones para la Tierra y el espacio." />
    <title>NASA Space Apps · Managua 2026</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="starfield" aria-hidden="true"><canvas id="starfield-canvas"></canvas></div>
    <header class="site-header">
      <a class="header-brand" href="#inicio" aria-label="NASA Space Apps Managua, inicio">
        <img src="/assets/logo-lineal-white.png" alt="NASA Space Apps Managua" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span>
        <span class="sr-only">Abrir menú</span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
        <a href="#evento">El evento</a>
        <a href="#flyer">Flyer</a>
        <a href="#organizadores">Organizadores</a>
        <a href={officialUrl} class="nav-cta" target="_blank" rel="noreferrer">Registro <span>sitio oficial ↗</span></a>
      </nav>
    </header>

    <main>
      <section id="inicio" class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> NASA Space Apps Challenge · Managua</p>
          <h1>El espacio<br /><em>empieza aquí.</em></h1>
          <p class="hero-intro">Una misión de 48 horas para convertir preguntas reales en soluciones que lleguen más lejos.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={officialUrl} target="_blank" rel="noreferrer">Ver sitio oficial <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#evento">Conocer la misión <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-meta" aria-label="Datos principales del evento">
            <div><strong>14—15</strong><span>Noviembre 2026</span></div>
            <div><strong>UAM</strong><span>Managua, Nicaragua</span></div>
          </div>
        </div>

        <div class="hero-orbit" aria-hidden="true">
          <div class="orbit-grid"></div>
          <div class="orbit-ring orbit-ring-one"></div>
          <div class="orbit-ring orbit-ring-two"></div>
          <span class="orbit-satellite"></span>
          <div class="hero-logo-crop"><img src="/assets/logo-circular-white.png" alt="" /></div>
          <p class="orbit-code">12°08'N<br />86°14'W</p>
          <p class="orbit-caption">SEDE OFICIAL<br /><strong>MANAGUA</strong></p>
        </div>
        <a class="scroll-cue" href="#evento"><span class="scroll-line"></span>Desliza para explorar</a>
      </section>

      <section class="event-strip" aria-label="Resumen del evento">
        <div><span class="strip-number">48</span><span class="strip-label">horas para crear</span></div>
        <div><span class="strip-number">165</span><span class="strip-label">participantes esperados</span></div>
        <div><span class="strip-number">01</span><span class="strip-label">misión compartida</span></div>
      </section>

      <section id="evento" class="content-section section-shell mission-section">
        <div class="section-heading">
          <p class="eyebrow"><span class="eyebrow-line"></span> La misión</p>
          <h2>Ideas con<br /><em>órbita propia.</em></h2>
        </div>
        <div class="mission-copy">
          <p class="lead">NASA Space Apps Challenge reúne a personas curiosas, creativas y técnicas para resolver desafíos usando datos abiertos de la NASA.</p>
          <p>Durante 48 horas, equipos de Nicaragua construirán prototipos, explorarán nuevas ideas y convertirán problemas de la Tierra y el espacio en oportunidades concretas.</p>
          <div class="mission-rule"></div>
          <p class="small-note">No necesitas ser astronauta. Solo necesitas una pregunta y ganas de construir.</p>
        </div>
      </section>

      <section class="facts-section section-shell" aria-label="Datos del hackathon">
        <div class="fact-card fact-card-large">
          <span class="fact-index">01 / tiempo</span>
          <strong>48<span>h</span></strong>
          <p>Una carrera creativa de principio a fin.</p>
        </div>
        <div class="fact-card fact-card-accent">
          <span class="fact-index">02 / sede</span>
          <strong>UAM</strong>
          <p>Jaguar Center · Managua</p>
        </div>
        <div class="fact-card">
          <span class="fact-index">03 / fecha</span>
          <strong>14—15</strong>
          <p>Noviembre de 2026</p>
        </div>
      </section>

      <section id="flyer" class="content-section section-shell flyer-section">
        <div class="flyer-frame">
          <div class="flyer-pin">Documento de misión <span>///</span></div>
          <img src="/assets/flyer-space-apps.jpg" alt="Flyer oficial del NASA Space Apps Challenge Managua 2026" loading="lazy" />
        </div>
        <div class="flyer-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> Información oficial</p>
          <h2>Todo comienza<br /><em>con un reto.</em></h2>
          <p>Guarda la fecha y comparte la señal. Muy pronto publicaremos el formulario de inscripción, los desafíos y todos los detalles para preparar tu misión.</p>
          <a class="text-link" href="#registro">Recibir información <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section id="registro" class="coming-section section-shell">
        <div class="coming-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> Canal de lanzamiento</p>
          <h2>Registro<br /><em>cerrado.</em></h2>
          <p>Las inscripciones de esta edición ya cerraron. Conservamos el enlace oficial para consultar información de NASA Space Apps.</p>
        </div>
        <div class="signal-panel">
          <div class="signal-top"><span class="signal-dot"></span> enlace oficial disponible</div>
          <div class="countdown" data-countdown>
            <div><strong data-days>--</strong><span>días</span></div>
            <div><strong data-hours>--</strong><span>horas</span></div>
            <div><strong data-minutes>--</strong><span>min</span></div>
            <div><strong data-seconds>--</strong><span>seg</span></div>
          </div>
          <p>Consulta los detalles directamente en el sitio oficial del evento.</p>
          <a class="button button-primary" href={officialUrl} target="_blank" rel="noreferrer">Abrir sitio oficial <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="sponsors" class="sponsors-section section-shell">
        <div class="section-heading centered-heading">
          <p class="eyebrow"><span class="eyebrow-line"></span> Apoyo a la misión</p>
          <h2>Sponsors<br /><em>próximamente.</em></h2>
          <p>Empresas y organizaciones que quieran impulsar talento nicaragüense podrán sumarse a esta misión.</p>
        </div>
        <div class="sponsor-placeholders" aria-label="Espacios para sponsors">
          <span>Tu organización</span><span>Tu organización</span><span>Tu organización</span>
        </div>
      </section>

      <section id="organizadores" class="organizers-section section-shell">
        <div class="organizer-intro">
          <p class="eyebrow"><span class="eyebrow-line"></span> La tripulación</p>
          <h2>Una misión<br /><em>en equipo.</em></h2>
        </div>
        <div class="organizer-list">
          <article class="organizer-item">
            <span class="organizer-number">01</span>
            <div><h3>ArtemisDevs</h3><p>Comunidad que impulsa tecnología, creatividad y colaboración desde Nicaragua.</p></div>
            <a href={socials.organizers} target="_blank" rel="noreferrer" aria-label="Ver enlaces de ArtemisDevs">↗</a>
          </article>
          <article class="organizer-item">
            <span class="organizer-number">02</span>
            <div><h3>UAM · FIA</h3><p>Facultad de Ingeniería y Arquitectura. Sede oficial que hace posible esta propuesta.</p></div>
            <span class="organizer-mark organizer-mark-image">
              <img src="/assets/logo-uam-nicaragua.jpg" alt="Logo de la Universidad Americana de Nicaragua" />
            </span>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <div class="footer-brand"><img src="/assets/logo-circular-white.png" alt="NASA Space Apps Managua" /><span>NASA Space Apps<br /><strong>Managua 2026</strong></span></div>
      <div class="footer-links">
        <a href={socials.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
        <a href={socials.tiktok} target="_blank" rel="noreferrer">TikTok ↗</a>
      </div>
      <p class="footer-note">Hecho para quienes miran más lejos.</p>
    </footer>

    <script>
      const menuButton = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('#site-nav');

      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        navigation?.classList.toggle('is-open', !isOpen);
      });

      navigation?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menuButton?.setAttribute('aria-expanded', 'false');
          navigation.classList.remove('is-open');
        });
      });

      const starCanvas = document.querySelector<HTMLCanvasElement>('#starfield-canvas');
      const starContext = starCanvas?.getContext('2d');

      if (starCanvas && starContext) {
        type Star = {
          x: number;
          y: number;
          depth: number;
          radius: number;
          opacity: number;
          speed: number;
          twinkle: number;
          phase: number;
          wander: number;
          wanderSpeed: number;
          pulseDepth: number;
          color: string;
        };

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const stars: Star[] = [];
        let width = 0;
        let height = 0;
        let pixelRatio = 1;
        let scrollOffset = window.scrollY;
        let scrollVelocity = 0;
        let targetScrollVelocity = 0;
        let lastScrollOffset = scrollOffset;
        let lastScrollTime = performance.now();
        let animationFrame = 0;

        const random = (min: number, max: number) => min + Math.random() * (max - min);

        const createStars = () => {
          stars.length = 0;
          const count = Math.min(300, Math.max(120, Math.floor((width * height) / 5600)));
          const colors = ['247,248,245', '166,176,201', '45,123,199', '229,255,0'];

          for (let index = 0; index < count; index += 1) {
            stars.push({
              x: random(0, width),
              y: random(0, height),
              depth: random(0.25, 1),
              radius: random(0.35, 1.35),
              opacity: random(0.15, 0.52),
              speed: random(0.9, 5.2),
              twinkle: random(0.7, 2.7),
              phase: random(0, Math.PI * 2),
              wander: random(3, 16),
              wanderSpeed: random(0.15, 0.65),
              pulseDepth: random(0.14, 0.3),
              color: colors[Math.floor(random(0, colors.length))],
            });
          }
        };

        const drawStars = (time: number) => {
          starContext.clearRect(0, 0, width, height);
          const elapsed = time / 1000;
          scrollVelocity += (targetScrollVelocity - scrollVelocity) * 0.18;
          targetScrollVelocity *= 0.9;

          stars.forEach((star) => {
            const wander = reducedMotion.matches ? 0 : Math.sin(elapsed * star.wanderSpeed + star.phase) * star.wander;
            const x = (star.x + (reducedMotion.matches ? 0 : elapsed * star.speed + wander) + width) % width;
            const y = (star.y - scrollOffset * star.depth * 0.035 + wander * 0.35 + height) % height;
            const pulse = reducedMotion.matches ? 1 : 0.76 + Math.sin(elapsed * star.twinkle + star.phase) * star.pulseDepth;
            const alpha = star.opacity * pulse;
            const scrollDirection = scrollVelocity > 0 ? -1 : 1;
            const streakLength = Math.min(58, Math.abs(scrollVelocity) * 30 * star.depth);

            if (streakLength > 1.5) {
              const streakEnd = y + scrollDirection * streakLength;

              if (streakEnd >= 0 && streakEnd <= height) {
                starContext.beginPath();
                starContext.strokeStyle = `rgba(${star.color}, ${alpha * 0.52})`;
                starContext.lineWidth = Math.max(0.6, star.radius * 1.1);
                starContext.moveTo(x, y);
                starContext.lineTo(x, streakEnd);
                starContext.stroke();
              }
            }

            starContext.beginPath();
            starContext.fillStyle = `rgba(${star.color}, ${alpha})`;
            starContext.arc(x, y, star.radius * (0.8 + star.depth * 0.35), 0, Math.PI * 2);
            starContext.fill();
          });

        };

        const animateStars = (time: number) => {
          drawStars(time);
          if (!reducedMotion.matches) animationFrame = window.requestAnimationFrame(animateStars);
        };

        const resizeStars = () => {
          width = window.innerWidth;
          height = window.innerHeight;
          pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
          starCanvas.width = width * pixelRatio;
          starCanvas.height = height * pixelRatio;
          starCanvas.style.width = `${width}px`;
          starCanvas.style.height = `${height}px`;
          starContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
          createStars();
          drawStars(0);
        };

        const updateScroll = () => {
          const now = performance.now();
          const elapsed = Math.max(16, now - lastScrollTime);
          const delta = window.scrollY - lastScrollOffset;

          targetScrollVelocity = Math.max(-2.4, Math.min(2.4, delta / elapsed));
          scrollOffset = window.scrollY;
          lastScrollOffset = scrollOffset;
          lastScrollTime = now;
        };
        const updateMotionPreference = () => {
          window.cancelAnimationFrame(animationFrame);
          resizeStars();
          if (!reducedMotion.matches) animationFrame = window.requestAnimationFrame(animateStars);
        };

        window.addEventListener('resize', resizeStars, { passive: true });
        window.addEventListener('scroll', updateScroll, { passive: true });
        reducedMotion.addEventListener('change', updateMotionPreference);
        resizeStars();
        if (!reducedMotion.matches) animationFrame = window.requestAnimationFrame(animateStars);
      }

      const target = new Date('2026-11-14T00:00:00-06:00').getTime();
      const countdown = document.querySelector('[data-countdown]');

      const updateCountdown = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalSeconds = Math.floor(remaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        const setValue = (selector: string, value: number) => {
          const node = countdown?.querySelector(selector);
          if (node) node.textContent = String(value).padStart(2, '0');
        };
        setValue('[data-days]', days);
        setValue('[data-hours]', hours);
        setValue('[data-minutes]', minutes);
        setValue('[data-seconds]', seconds);
      };

      updateCountdown();
      window.setInterval(updateCountdown, 1000);
    </script>
  </body>
</html>
